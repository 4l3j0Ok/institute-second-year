---
import Layout from "../../layouts/Layout.astro";
import { getCar } from "../../lib/cars";
import { mapCarFromAPI } from "../../types/car";

const { car_code } = Astro.params;
const response = await getCar(car_code);
const carFromAPI = response.items[0];
const car = mapCarFromAPI(carFromAPI);
---

<Layout>
    <main>
        <section class="car" style={`view-transition-name: car-${car.code}`}>
            <section class="car-header">
                <section class="car-presentation">
                    {
                        car.img && (
                            <img
                                src={car.img}
                                alt={`Imagen de ${car.brand} ${car.model}`}
                                style={`view-transition-name: image-${car.code}`}
                            />
                        )
                    }
                </section>
                <section class="car-info">
                    <h1>{car.brand} {car.model}</h1>
                    <p><b>{car.km} km</b></p>
                    <p>
                        {
                            car.promotionPrice &&
                            car.promotionPrice < car.price ? (
                                <span class="old-price">${car.price}</span>
                            ) : null
                        }
                        ${car.promotionPrice ?? car.price}
                    </p>
                </section>
            </section>
            <section class="car-description">
                <h2>Descripción</h2>
                <p>{car.description}</p>
            </section>
        </section>
    </main>
</Layout>

<style>
    main {
        background-color: white;
        padding: 2em;
        display: flex;
        justify-content: center;
        border-radius: var(--border-radius-bottom);
        box-shadow: var(--box-shadow);
    }

    .car {
        width: 80%;
        display: flex;
        flex-direction: column;
    }

    .car-header {
        display: flex;
        justify-content: space-between;
        gap: 2em;
        margin-bottom: 2em;
    }

    .car-info {
        text-align: right;
    }

    .car-info h1 {
        font-size: 2rem;
        color: var(--primary-color);
        margin: 0;
    }

    .car-description {
        width: 100%;
    }

    .car .old-price {
        text-decoration: line-through;
        color: var(--red-color);
    }

    .car-presentation img {
        width: 640px;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
    }
</style>
