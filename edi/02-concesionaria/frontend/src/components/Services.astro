---
import { Image } from "astro:assets";
import carImage from "../assets/images/white-toyota-transparent.png";
---

<section class="services">
    <article class="service-card">
        <div class="service-car">
            <Image src={carImage} alt="Auto blanco" />
        </div>
        <div class="description">
            <h3>Financiá tu auto</h3>
            <p>Ofrecemos planes de financiación adaptados a tus necesidades.</p>
            <button>Más información</button>
        </div>
    </article>
</section>

<style>
    .service-card {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        background-color: var(--primary-color);
        color: white;
        border-radius: var(--border-radius);
        padding: 1em;
        box-shadow: var(--box-shadow);
        padding-right: 4em;
        padding-left: 4em;
    }

    .service-card button {
        background-color: white;
        color: var(--primary-color);
        border: none;
        padding: 0.5em 1em;
        border-radius: var(--border-radius);
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .service-card img {
        width: 100%;
        object-fit: cover;
        border-radius: var(--border-radius);
    }
    @media (max-width: 768px) {
        .service-card {
            flex-direction: column;
            align-items: center;
        }
    }
</style>
