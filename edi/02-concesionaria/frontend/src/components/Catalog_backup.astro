---

<section class="catalog">
    <h2>Ofertas</h2>
    <div class="catalog-content">
        <button class="arrow-button" id="prev-button"
            ><iconify-icon icon="bxs:left-arrow"></iconify-icon></button
        >
        <div class="catalog-cars">
            {
                cars.map((car) => (
                    <a href="${endpoint}" class="car-link">
                        <div class="car" id="${car.brand}-${car.model}">
                            <Image
                                src={CarImage}
                                alt="{car.brand} {car.model}"
                                class="car-image"
                            />
                            <h2>
                                ${car.brand} ${car.model}
                            </h2>
                            <p class="price">${car.price}</p>
                        </div>
                    </a>
                ))
            }
        </div>
        <button class="arrow-button" id="next-button"
            ><iconify-icon icon="bxs:right-arrow"></iconify-icon></button
        >
    </div>
    <div class="view-all">
        <button class="view-all-offers" id="view-all-offers"
            >Ver todas las ofertas</button
        >
        <button class="view-all-button" id="view-all-button"
            >Ver todo el catálogo</button
        >
    </div>
</section>

<style>
    .car {
        background-color: #fff;
        border-radius: var(--border-radius);
        padding: 1em;
        box-shadow: var(--box-shadow);
    }

    .car img {
        width: 240px;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: var(--border-radius);
    }

    .car-link {
        text-decoration: none;
        color: black;
    }

    .car .old-price {
        text-decoration: line-through;
        color: var(--red-color);
    }

    .catalog-content {
        width: 100%;
        display: flex;
        flex-direction: row;
        align-items: center;
        overflow: hidden;
        position: relative;
    }

    .catalog-content .arrow-button {
        position: absolute;
        box-shadow: var(--box-shadow);
        border-radius: 100%;
        margin: 1em;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        background-color: white;
        color: var(--primary-color);
    }

    .catalog-content #prev-button {
        left: 0;
    }

    .catalog-content #next-button {
        right: 0;
    }

    .catalog-cars {
        display: flex;
        gap: 2em;
        padding: 1em;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
    }

    .catalog .view-all {
        margin-top: 1em;
        display: flex;
        justify-content: center;
        gap: 2em;
    }
</style>
