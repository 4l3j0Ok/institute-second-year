---
import Image from "astro/components/Image.astro";
import Logo from "../assets/images/logo-black-outline.webp";
---

<header>
    <div class="header-content">
        <div class="logo">
            <a href="/">
                <Image
                    class="logo-image"
                    src={Logo}
                    alt="Logo Premium Quality"
                /></a
            >
            <h1><a href="/">Premium Quality</a></h1>
        </div>
        <div class="options">
            <a href="/">Página Principal</a>
            <a href="./financing.html">Financiación</a>
            <a href="./offers.html">Ofertas</a>
        </div>
    </div>
</header>

<style>
    header {
        width: 100%;
        background-color: white;
        color: black;
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        justify-content: center;
        height: 4em;
        box-shadow: var(--box-shadow);
        z-index: 1000;
    }

    .header-content {
        width: 100%;
        padding-left: 2em;
        padding-right: 2em;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .header-content .logo {
        display: flex;
        align-items: center;
    }

    .header-content .logo-image {
        height: 3em;
    }

    .header-content img {
        width: 100%;
        height: 100%;
    }

    .header-content a {
        margin-right: 2em;
        color: black;
        text-decoration: none;
    }

    .header-content a:last-child {
        margin-right: 0;
    }
</style>
