---
import { Image } from "astro:assets";
import CarImage from "../assets/images/chevrolet-astra.webp";
import { getCar } from "../lib/cars";

// Inicializar con array vacío
let cars = [];

try {
    const carsResponse = await getCar();
    console.log("API Response:", carsResponse);

    if (carsResponse && Array.isArray(carsResponse.items)) {
        // Mapear los datos de la API al formato esperado por el componente
        cars = carsResponse.items.map((car: any) => ({
            id: car.car_code,
            brand: car.brand,
            model: car.model,
            description: car.description,
            price: car.price,
            promotionPrice: car.promotion_price,
            km: car.km,
            year: car.year,
            img: car.img || "./assets/images/chevrolet-astra.webp", // fallback image
        }));
    }
} catch (error) {
    console.error("Error fetching cars from API:", error);
    cars = [];
}

console.log("Final cars array:", cars);
---

<section class="catalog">
    <h2>Ofertas</h2>
    <div class="catalog-content">
        <button class="arrow-button" id="prev-button"
            ><iconify-icon icon="bxs:left-arrow"></iconify-icon></button
        >
        <div class="catalog-cars">
            {
                cars.length > 0 ? (
                    cars.map((car: any) => (
                        <a href={`/cars/${car.id}`} class="car-link">
                            <div class="car" id={`${car.brand}-${car.model}`}>
                                {car.img && car.img.startsWith("http") ? (
                                    <img
                                        src={car.img}
                                        alt={`${car.brand} ${car.model}`}
                                        class="car-image"
                                    />
                                ) : (
                                    <Image
                                        src={CarImage}
                                        alt={`${car.brand} ${car.model}`}
                                        class="car-image"
                                    />
                                )}
                                <h2>
                                    {car.brand} {car.model}
                                </h2>
                                {car.promotionPrice ? (
                                    <div>
                                        <p class="old-price">
                                            ${car.price.toLocaleString()}
                                        </p>
                                        <p class="price">
                                            $
                                            {car.promotionPrice.toLocaleString()}
                                        </p>
                                    </div>
                                ) : (
                                    <p class="price">
                                        ${car.price.toLocaleString()}
                                    </p>
                                )}
                                <p class="car-details">
                                    {car.year} • {car.km.toLocaleString()} km
                                </p>
                            </div>
                        </a>
                    ))
                ) : (
                    <div class="no-cars-message">
                        <p>No hay vehículos disponibles en este momento.</p>
                        <p>
                            Por favor, verifica que la API esté funcionando
                            correctamente.
                        </p>
                    </div>
                )
            }
        </div>
        <button class="arrow-button" id="next-button"
            ><iconify-icon icon="bxs:right-arrow"></iconify-icon></button
        >
    </div>
    <div class="view-all">
        <button class="view-all-offers" id="view-all-offers"
            >Ver todas las ofertas</button
        >
        <button class="view-all-button" id="view-all-button"
            >Ver todo el catálogo</button
        >
    </div>
</section>

<style>
    .car {
        background-color: #fff;
        border-radius: var(--border-radius);
        padding: 1em;
        box-shadow: var(--box-shadow);
        min-width: 300px;
        display: flex;
        flex-direction: column;
        gap: 0.5em;
    }

    .car img {
        width: 240px;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: var(--border-radius);
    }

    .car-link {
        text-decoration: none;
        color: black;
    }

    .car .old-price {
        text-decoration: line-through;
        color: var(--red-color);
        font-size: 0.9em;
        margin: 0;
    }

    .car .price {
        color: var(--green-color);
        font-weight: bold;
        font-size: 1.2em;
        margin: 0;
    }

    .car-details {
        color: #666;
        font-size: 0.9em;
        margin: 0;
    }

    .catalog {
        margin: 2em 0;
    }

    .catalog h2 {
        text-align: center;
        margin-bottom: 1em;
    }

    .catalog-content {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .arrow-button {
        background-color: var(--primary-color);
        color: white;
        border: none;
        padding: 1em;
        border-radius: 50%;
        cursor: pointer;
        position: absolute;
        z-index: 10;
        font-size: 1.2em;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
    }

    .arrow-button:hover {
        background-color: var(--primary-dark);
    }

    #prev-button {
        left: 0;
    }

    #next-button {
        right: 0;
    }

    .catalog-cars {
        display: flex;
        gap: 2em;
        padding: 1em;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        max-width: calc(100vw - 120px);
    }

    .catalog-cars::-webkit-scrollbar {
        display: none;
    }

    .no-cars-message {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2em;
        text-align: center;
        color: #666;
        min-height: 200px;
    }

    .no-cars-message p {
        margin: 0.5em 0;
    }

    .catalog .view-all {
        margin-top: 1em;
        display: flex;
        justify-content: center;
        gap: 2em;
    }

    .view-all-offers,
    .view-all-button {
        background-color: var(--secondary-color);
        color: white;
        border: none;
        padding: 1em 2em;
        border-radius: var(--border-radius);
        cursor: pointer;
        font-size: 1em;
    }

    .view-all-offers:hover,
    .view-all-button:hover {
        background-color: var(--secondary-dark);
    }

    @media (max-width: 768px) {
        .catalog-cars {
            max-width: calc(100vw - 80px);
        }

        .arrow-button {
            width: 40px;
            height: 40px;
            font-size: 1em;
        }

        .catalog .view-all {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const catalogCars = document.querySelector(".catalog-cars");
        const prevButton = document.getElementById("prev-button");
        const nextButton = document.getElementById("next-button");

        if (catalogCars && prevButton && nextButton) {
            prevButton.addEventListener("click", () => {
                catalogCars.scrollBy({ left: -300, behavior: "smooth" });
            });

            nextButton.addEventListener("click", () => {
                catalogCars.scrollBy({ left: 300, behavior: "smooth" });
            });
        }
    });
</script>
